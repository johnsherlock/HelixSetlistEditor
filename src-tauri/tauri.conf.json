{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Helix Setlist Editor",
  "version": "0.1.0",
  "identifier": "com.helixsetlist.editor",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist/web"
  },
  "app": {
    "windows": [
      {
        "title": "Helix Setlist Editor",
        "width": 1440,
        "height": 1380,
        "minWidth": 500,
        "maxWidth": 1440,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/Blank_Setlist.hls"
    ]
  }
}
